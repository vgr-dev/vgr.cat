---
/**
 * Site chrome for every page: skip link, header, main landmark and footer.
 *
 * Owns the navigation data — `sectionNav` is the single source the header and the footer both
 * consume — and owns the skip link so it cannot be forgotten on a new page. `BaseLayout` stays
 * the document shell (html/head/body).
 */
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { useTranslations } from '../i18n';
import { bookingUrl } from '../config';
import { sectionNav } from '../lib/navigation';
import { localizedPath, type Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = sectionNav(lang);

// The trailing slash is the canonical form `build.format: 'directory'` emits; without it the edge
// answers with a redirect hop.
const legalHref = localizedPath(lang, '/privacy/');
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:border focus:border-control-border focus:bg-bg focus:px-4 focus:py-2 focus:font-medium focus:text-fg"
>
  {t.header.skipToContent}
</a>
<SiteHeader
  lang={lang}
  brand={t.header.brand}
  homeHref={localizedPath(lang, '/')}
  nav={nav}
  menuLabel={t.header.menuLabel}
  primaryNavLabel={t.header.primaryNavLabel}
  languageNavLabel={t.header.languageNavLabel}
  bookCallLabel={t.nav.bookCall}
  bookCallHref={bookingUrl}
/>
<main id="main-content" tabindex="-1">
  <slot />
</main>
<SiteFooter
  lang={lang}
  tagline={t.footer.tagline}
  builtWith={t.footer.builtWith}
  nav={nav}
  sectionsLabel={t.footer.sectionsLabel}
  contactLabel={t.footer.contactLabel}
  languageLabel={t.footer.languageLabel}
  bookingLabel={t.contact.directContact.calendarButton}
  bookingHref={bookingUrl}
  legalLabel={t.footer.legalLabel}
  legalHref={legalHref}
/>
