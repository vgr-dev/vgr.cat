---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import HomeSections from '../../components/HomeSections.astro';
import { locales, defaultLocale, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export const getStaticPaths = (() =>
  locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.site.title} description={t.site.description}>
  <PageShell lang={lang}>
    <HomeSections lang={lang} />
  </PageShell>
</BaseLayout>
