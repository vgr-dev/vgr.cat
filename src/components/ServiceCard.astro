---
import Card from './Card.astro';

interface Props {
  title: string;
  tag: string;
  /** One line of what the capability is. The body lives on `/services/<translationKey>/`. */
  summary: string;
  /** Detail page for this capability. */
  href: string;
  /** Visible affordance; the title link carries the accessible name. */
  ctaLabel: string;
}

const { title, tag, summary, href, ctaLabel } = Astro.props;
---

<Card
  title={title}
  href={href}
  tag={tag}
  summary={summary}
  ctaLabel={ctaLabel}
/>
