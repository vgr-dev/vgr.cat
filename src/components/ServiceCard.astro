---
interface Props {
  title: string;
  tag: string;
  /** Detail page for this capability. */
  href: string;
  /** Visible affordance; the title link carries the accessible name. */
  ctaLabel: string;
}

const { title, tag, href, ctaLabel } = Astro.props;
---

{/* `relative` + the anchor's `after:inset-0` make the whole card clickable from one focus stop. */}
<article class="relative rounded-lg border border-border bg-surface p-6">
  <p class="text-xs font-medium tracking-wide text-accent uppercase">{tag}</p>
  <h3 class="mt-2 text-lg font-semibold tracking-tight">
    <a href={href} class="hover:text-accent after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <div class="prose prose-sm mt-3 max-w-none text-muted dark:prose-invert">
    <slot />
  </div>
  <p class="mt-4 text-sm font-medium text-accent">{ctaLabel}</p>
</article>
