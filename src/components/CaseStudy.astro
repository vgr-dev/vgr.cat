---
/**
 * Case-study card: the scannable summary layer only.
 *
 * The markdown body is *not* rendered here. It used to be, and it restated the three `<dl>` items
 * in prose — the same three ideas twice per study, six times on the page (UX-007). The body now
 * belongs to `/work/<translationKey>/`; this card never renders it.
 *
 * The surface, the anchor and the CTA come from `Card.astro`; this component only decides what the
 * body is, which differs between the index (`teaser`) and the related-work row on a service page
 * (`full`).
 */
import Card from './Card.astro';

interface Props {
  title: string;
  summary: string;
  problemLabel: string;
  approachLabel: string;
  outcomeLabel: string;
  problem: string;
  approach: string;
  outcome: string;
  /** Detail page for this study. */
  href: string;
  /** Visible affordance; the title link carries the accessible name. */
  ctaLabel: string;
  /** Pillar tag, shown above the title. */
  tag?: string;
  /**
   * `full` renders the three-part `<dl>`; `teaser` renders only the outcome line. The home page is
   * an index, so it uses `teaser` and the reader opens the page for the challenge and the approach.
   */
  variant?: 'full' | 'teaser';
}

const {
  title,
  summary,
  problemLabel,
  approachLabel,
  outcomeLabel,
  problem,
  approach,
  outcome,
  href,
  ctaLabel,
  tag,
  variant = 'full',
} = Astro.props;
---

<Card title={title} href={href} tag={tag} summary={summary} ctaLabel={ctaLabel}>
  {variant === 'full' ? (
    <dl class="grid gap-6 lg:grid-cols-3">
      <div>
        <dt class="card-label">{problemLabel}</dt>
        <dd class="mt-1 max-w-[var(--measure)] text-muted">{problem}</dd>
      </div>
      <div>
        <dt class="card-label">{approachLabel}</dt>
        <dd class="mt-1 max-w-[var(--measure)] text-muted">{approach}</dd>
      </div>
      <div>
        <dt class="card-label">{outcomeLabel}</dt>
        <dd class="mt-1 max-w-[var(--measure)] text-muted">{outcome}</dd>
      </div>
    </dl>
  ) : (
    <div>
      <p class="card-label">{outcomeLabel}</p>
      <p class="mt-1 line-clamp-2 text-muted">{outcome}</p>
    </div>
  )}
</Card>
