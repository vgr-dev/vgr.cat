---
import '../styles/global.css';
import {
  defaultLocale,
  locales,
  localizedPath,
  stripLocale,
  type Locale,
} from '../i18n/config';
import { useTranslations } from '../i18n';
import { buildJsonLd } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /**
   * A 404 is a single prerendered file answering every path, so it has no canonical URL of
   * its own. Without this, the page advertised `https://vgr.cat/404/` as its canonical plus
   * three hreflang siblings that do not resolve (live `GET /404/` → 307, `/ca/404/` → 404).
   */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = defaultLocale,
  noindex = false,
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 1200x630 brand card. Regeneration command is recorded in the active plan (Phase 5, Task 5.2).
const ogImageURL = new URL('/og/og-default.png', Astro.site);

const logicalPath = stripLocale(Astro.url.pathname);
const alternates = locales.map((locale) => ({
  locale,
  href: new URL(localizedPath(locale, logicalPath), Astro.site).href,
}));
const xDefaultHref = new URL(
  localizedPath(defaultLocale, logicalPath),
  Astro.site,
).href;

const ogLocale: Record<Locale, string> = {
  en: 'en_US',
  ca: 'ca_ES',
  es: 'es_ES',
};

const jsonLd = buildJsonLd({ locale: lang, t: useTranslations(lang) });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex &&
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vgr.cat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales
      .filter((locale) => locale !== lang)
      .map((locale) => (
        <meta property="og:locale:alternate" content={ogLocale[locale]} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/*
      Cloudflare Web Analytics is NOT emitted here. It is injected at the edge by the zone's
      Web Analytics auto-install, so it must be allowed by origin in `security.csp`
      (`static.cloudflareinsights.com` for the script, `cloudflareinsights.com` for its report).
      An explicit beacon was built first and removed deliberately: with auto-install on, shipping
      both would count every pageview twice.
    */}
  </head>
  <body>
    <slot name="header" />
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
