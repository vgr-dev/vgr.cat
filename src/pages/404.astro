---
/**
 * One prerendered 404 answers every path, so the requested locale only exists at runtime. The
 * page renders the default locale's copy once and the script swaps in the requested one from the
 * JSON island below — a single `h1` in the document, instead of one per locale (UX-008).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import Container from '../components/Container.astro';
import { dictionaries } from '../i18n';
import { defaultLocale, locales, localizedPath } from '../i18n/config';

const fallback = dictionaries[defaultLocale].notFound;

const copy = Object.fromEntries(
  locales.map((locale) => [
    locale,
    {
      ...dictionaries[locale].notFound,
      href: localizedPath(locale, '/'),
    },
  ]),
);
---

<BaseLayout
  lang={defaultLocale}
  title={fallback.title}
  description={fallback.body}
  noindex
>
  <script
    type="application/json"
    data-notfound-copy
    set:html={JSON.stringify(copy).replace(/</g, '\\u003c')}
  ></script>
  <PageShell lang={defaultLocale}>
    <Container class="py-24">
      <h1 class="text-3xl font-semibold tracking-tight" data-notfound-heading>
        {fallback.heading}
      </h1>
      <p class="mt-4 max-w-2xl text-muted" data-notfound-body>
        {fallback.body}
      </p>
      <p class="mt-8">
        <a href="/" class="text-accent hover:underline" data-notfound-back>
          {fallback.back}
        </a>
      </p>
    </Container>
  </PageShell>
</BaseLayout>

<script>
  import { defaultLocale, isLocale } from '../i18n/config';

  interface NotFoundCopy {
    title: string;
    heading: string;
    body: string;
    back: string;
    href: string;
  }

  const island = document.querySelector<HTMLScriptElement>(
    '[data-notfound-copy]',
  );
  const heading = document.querySelector<HTMLElement>(
    '[data-notfound-heading]',
  );
  const body = document.querySelector<HTMLElement>('[data-notfound-body]');
  const back = document.querySelector<HTMLAnchorElement>(
    '[data-notfound-back]',
  );

  if (island?.textContent && heading && body && back) {
    const copy = JSON.parse(island.textContent) as Record<string, NotFoundCopy>;
    const requested = window.location.pathname.split('/')[1] ?? '';
    const target = isLocale(requested) ? requested : defaultLocale;
    const words = copy[target];
    const description = document.querySelector<HTMLMetaElement>(
      'meta[name="description"]',
    );

    if (words) {
      document.documentElement.lang = target;
      document.title = words.title;
      heading.textContent = words.heading;
      body.textContent = words.body;
      back.textContent = words.back;
      back.href = words.href;
      if (description) description.content = words.body;
    }
  }
</script>
