---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ServiceDetail from '../../../components/pages/ServiceDetail.astro';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n';
import { getService, getServices } from '../../../lib/content';
import { buildServiceJsonLd } from '../../../lib/schema';

export const getStaticPaths = (async () => {
  const paths: { params: { lang: Locale; slug: string } }[] = [];
  for (const locale of locales.filter((value) => value !== defaultLocale)) {
    for (const entry of await getServices(locale)) {
      paths.push({
        params: { lang: locale, slug: entry.data.translationKey },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const entry = await getService(lang, slug);
if (entry === undefined) {
  throw new Error(`No service "${slug}" for locale "${lang}"`);
}

const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  jsonLd={buildServiceJsonLd({ locale: lang, t, entry })}
>
  <PageShell lang={lang}>
    <ServiceDetail lang={lang} entry={entry} />
  </PageShell>
</BaseLayout>
