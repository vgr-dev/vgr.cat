---
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  orDivider: string;
  calendarLabel: string;
  calendarHref: string;
  emailLabel: string;
  emailAddress: string;
  locationLabel: string;
  locationValue: string;
  timezone: string;
}

const {
  eyebrow,
  heading,
  body,
  orDivider,
  calendarLabel,
  calendarHref,
  emailLabel,
  emailAddress,
  locationLabel,
  locationValue,
  timezone,
} = Astro.props;
---

<Container as="section" id="contact" class="py-20">
  <p class="text-sm font-medium text-accent">{eyebrow}</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
    {heading}
  </h2>
  <p class="mt-4 max-w-2xl text-muted">{body}</p>

  {/* The spam-protected form is supplied by the caller. */}
  <slot />

  <div class="mt-12 border-t border-border pt-8">
    <p class="text-sm font-medium">{orDivider}</p>
    <Button href={calendarHref} class="mt-4">
      {calendarLabel}
    </Button>

    <dl class="mt-8 grid gap-6 text-sm sm:grid-cols-3">
      <div>
        <dt class="font-medium">{emailLabel}</dt>
        <dd class="mt-1 text-muted">
          <a href={`mailto:${emailAddress}`} class="hover:text-accent">
            {emailAddress}
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-medium">{locationLabel}</dt>
        <dd class="mt-1 text-muted">
          {locationValue}
          <span class="mt-1 block text-xs">{timezone}</span>
        </dd>
      </div>
    </dl>
  </div>
</Container>
