---
import Container from './Container.astro';
import Hero from './Hero.astro';
import ServiceCard from './ServiceCard.astro';
import CaseStudy from './CaseStudy.astro';
import CtaBand from './CtaBand.astro';
import ContactSection from './ContactSection.astro';
import ContactForm from './ContactForm.astro';
import { useTranslations } from '../i18n';
import { bookingUrl, contactEmail } from '../config';
import { localizedPath, type Locale } from '../i18n/config';
import { getCaseStudies, getServices } from '../lib/content';
import { aboutPath, caseStudyPath, servicePath } from '../lib/paths';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The home page is an index, not a document: it renders no collection body. `render()` from
 * `astro:content` is not imported here, so a body cannot reappear on the hub without someone
 * deliberately adding the import back — which is the point.
 */
const services = await getServices(lang);
const caseStudies = await getCaseStudies(lang);
const aboutHref = localizedPath(lang, aboutPath());
---

<Hero
  badge={t.hero.badge}
  title={t.hero.title}
  titleHighlight={t.hero.titleHighlight}
  subtitle={t.hero.subtitle}
  ctaPrimary={t.hero.ctaPrimary}
  ctaPrimaryHref={bookingUrl}
  ctaSecondary={t.hero.ctaSecondary}
  ctaSecondaryHref="#work"
  metrics={t.hero.metrics}
/>

<section id="services" class="bg-band" data-reveal>
  <Container class="py-[var(--space-section)]">
    <p class="text-sm font-medium text-accent-ink">{t.services.eyebrow}</p>
    <h2 class="mt-2 text-2xl font-semibold">{t.services.title}</h2>
    <p class="mt-4 max-w-2xl text-muted">{t.services.subtitle}</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {services.map((entry) => (
        <ServiceCard
          title={entry.data.title}
          tag={t.services.pillars[entry.data.pillar].tag}
          summary={entry.data.summary}
          href={localizedPath(lang, servicePath(entry.data.translationKey))}
          ctaLabel={t.services.readService}
        />
      ))}
    </div>
  </Container>
</section>

<Container as="section" id="work" class="py-[var(--space-section)]" data-reveal>
  <p class="text-sm font-medium text-accent">{t.caseStudies.eyebrow}</p>
  <h2 class="mt-2 text-2xl font-semibold">{t.caseStudies.title}</h2>
  <p class="mt-4 max-w-2xl text-muted">{t.caseStudies.subtitle}</p>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {caseStudies.map((entry) => (
      <CaseStudy
        title={entry.data.title}
        summary={entry.data.summary}
        problemLabel={t.caseStudies.labels.problem}
        approachLabel={t.caseStudies.labels.approach}
        outcomeLabel={t.caseStudies.labels.outcome}
        problem={entry.data.problem}
        approach={entry.data.approach}
        outcome={entry.data.outcome}
        href={localizedPath(lang, caseStudyPath(entry.data.translationKey))}
        ctaLabel={t.caseStudies.readCase}
        tag={t.services.pillars[entry.data.pillar].tag}
        variant="teaser"
      />
    ))}
  </div>
</Container>

<section class="bg-band" data-reveal>
  <Container class="py-[var(--space-section)]">
    <p class="text-sm font-medium text-accent-ink">{t.about.eyebrow}</p>
    <h2 class="mt-2 text-2xl font-semibold">{t.about.title}</h2>
    <p class="mt-4 max-w-2xl text-muted">{t.about.teaser}</p>
    <a
      href={aboutHref}
      class="mt-4 inline-block py-1 text-sm font-medium text-accent-ink hover:underline"
    >
      {t.about.readMore}
    </a>
  </Container>
</section>

<CtaBand
  title={t.ctaBand.title}
  body={t.ctaBand.body}
  primaryLabel={t.ctaBand.primary}
  primaryHref={bookingUrl}
  secondaryLabel={t.ctaBand.secondary}
  secondaryHref="#work"
/>

<ContactSection
  eyebrow={t.contact.eyebrow}
  heading={t.contact.title}
  body={t.contact.subtitle}
  orDivider={t.contact.directContact.orDivider}
  calendarLabel={t.contact.directContact.calendarButton}
  calendarHref={bookingUrl}
  emailLabel={t.contact.directContact.emailDirect}
  emailAddress={contactEmail}
  locationLabel={t.contact.directContact.locationLabel}
  locationValue={t.contact.directContact.locationValue}
  timezone={t.contact.directContact.timezone}
>
  <ContactForm
    lang={lang}
    labels={t.contact.form}
    bookingLabel={t.contact.directContact.calendarButton}
    privacyHref={localizedPath(lang, '/privacy/')}
  />
</ContactSection>
