---
interface Props {
  title: string;
  tag: string;
}

const { title, tag } = Astro.props;
---

<article class="rounded-lg border border-border bg-surface p-6">
  <p class="text-xs font-medium tracking-wide text-accent uppercase">{tag}</p>
  <h3 class="mt-2 text-lg font-semibold tracking-tight">{title}</h3>
  <div class="prose prose-sm mt-3 max-w-none text-muted dark:prose-invert">
    <slot />
  </div>
</article>
