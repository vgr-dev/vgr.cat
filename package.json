{
  "name": "vgr-cat",
  "type": "module",
  "version": "0.0.1",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "npm run types && astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:e2e": "PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA astro build",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test",
    "posttest:e2e": "astro preview stop",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
