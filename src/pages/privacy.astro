---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import Container from '../components/Container.astro';
import { defaultLocale } from '../i18n/config';
import { useTranslations } from '../i18n';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.privacy.title} description={t.privacy.intro}>
  <PageShell lang={lang}>
    <Container class="py-24">
      <h1 class="text-3xl font-semibold tracking-tight">{t.privacy.heading}</h1>
      <p class="mt-4 max-w-2xl text-muted">{t.privacy.intro}</p>
      <p class="mt-2 text-sm text-muted">{t.privacy.updated}</p>
      <div class="mt-10 grid max-w-2xl gap-8">
        {t.privacy.sections.map((section) => (
          <section>
            <h2 class="text-lg font-semibold">{section.heading}</h2>
            <p class="mt-2 text-muted">{section.body}</p>
          </section>
        ))}
      </div>
    </Container>
  </PageShell>
</BaseLayout>
