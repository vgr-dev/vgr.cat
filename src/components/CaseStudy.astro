---
/**
 * Case-study card: the scannable summary layer only.
 *
 * The markdown body is *not* rendered here. It used to be, and it restated the three `<dl>` items
 * in prose — the same three ideas twice per study, six times on the page (UX-007). The body now
 * belongs to `/work/<translationKey>/`; this card never renders it.
 */
interface Props {
  title: string;
  summary: string;
  problemLabel: string;
  approachLabel: string;
  outcomeLabel: string;
  problem: string;
  approach: string;
  outcome: string;
  /** Detail page for this study. */
  href: string;
  /** Visible affordance; the title link carries the accessible name. */
  ctaLabel: string;
}

const {
  title,
  summary,
  problemLabel,
  approachLabel,
  outcomeLabel,
  problem,
  approach,
  outcome,
  href,
  ctaLabel,
} = Astro.props;
---

{/* `relative` + the anchor's `after:inset-0` make the whole card clickable from one focus stop. */}
<article class="relative border-t border-border py-10">
  <h3 class="text-xl font-semibold tracking-tight">
    <a href={href} class="hover:text-accent after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="mt-2 max-w-2xl text-muted">{summary}</p>
  <dl class="mt-6 grid gap-6 lg:grid-cols-3">
    <div>
      <dt class="text-sm font-medium text-accent">{problemLabel}</dt>
      <dd class="mt-1 max-w-[var(--measure)] text-muted">{problem}</dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-accent">{approachLabel}</dt>
      <dd class="mt-1 max-w-[var(--measure)] text-muted">{approach}</dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-accent">{outcomeLabel}</dt>
      <dd class="mt-1 max-w-[var(--measure)] text-muted">{outcome}</dd>
    </div>
  </dl>
  <p class="mt-6 text-sm font-medium text-accent">{ctaLabel}</p>
</article>
