---
/**
 * Link or button sharing one visual contract: variants, sizes, and the hover/active/disabled
 * states that were previously retyped at every call site.
 *
 * Renders an `<a>` when `href` is given, otherwise a `<button>`. Extra attributes are forwarded,
 * so a caller can keep `data-*` hooks the inline scripts depend on.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-md font-medium transition-[color,background-color,border-color,opacity] duration-[var(--duration-fast)] ease-[var(--ease-standard)] disabled:pointer-events-none disabled:opacity-60 aria-disabled:pointer-events-none aria-disabled:opacity-60';

const variants = {
  primary: 'bg-accent text-bg hover:opacity-90 active:opacity-80',
  secondary:
    'border border-control-border text-fg hover:text-accent active:bg-surface',
};

const sizes = {
  md: 'px-6 py-3',
  sm: 'px-4 py-2 text-sm',
};
---

{href ? (
  <a
    href={href}
    class:list={[base, variants[variant], sizes[size], className]}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class:list={[base, variants[variant], sizes[size], className]}
    {...rest}
  >
    <slot />
  </button>
)}
