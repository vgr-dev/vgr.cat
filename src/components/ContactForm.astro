---
import { turnstileSiteKey, turnstileAction } from '../config';
import type { Dictionary } from '../i18n';

interface Props {
  lang: string;
  labels: Dictionary['contact']['form'];
}

const { lang, labels } = Astro.props;

const inputClass =
  'w-full min-w-0 rounded border border-border bg-surface px-3 py-2 text-fg focus-visible:outline-2 focus-visible:outline-accent';
---

<form
  method="post"
  action="/api/contact"
  class="mt-8 grid max-w-2xl gap-4"
  data-submitting={labels.submitting}
  data-error-message={labels.errorMessage}
>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="elapsed" value="" data-elapsed />

  <label class="grid gap-1">
    <span class="text-sm font-medium">{labels.nameLabel}</span>
    <input
      name="name"
      required
      maxlength="2000"
      autocomplete="name"
      class={inputClass}
    />
  </label>

  <label class="grid gap-1">
    <span class="text-sm font-medium">{labels.emailLabel}</span>
    <input
      name="email"
      type="email"
      required
      maxlength="2000"
      autocomplete="email"
      class={inputClass}
    />
  </label>

  <label class="grid min-w-0 gap-1">
    <span class="text-sm font-medium">{labels.organizationLabel}</span>
    <input
      name="organization"
      required
      maxlength="2000"
      autocomplete="organization"
      placeholder={labels.organizationPlaceholder}
      class={inputClass}
    />
  </label>

  <label class="grid min-w-0 gap-1">
    <span class="text-sm font-medium">{labels.serviceTypeLabel}</span>
    <select name="serviceType" required class={inputClass}>
      <option value="" disabled selected>
        {labels.serviceTypeLabel}
      </option>
      {Object.entries(labels.serviceTypes).map(([value, label]) => (
        <option value={value}>{label}</option>
      ))}
    </select>
  </label>

  <label class="grid gap-1">
    <span class="text-sm font-medium">{labels.messageLabel}</span>
    <textarea
      name="message"
      rows="5"
      required
      maxlength="2000"
      class={inputClass}
    ></textarea>
  </label>

  <div class="hidden" aria-hidden="true">
    <label>
      Leave this field empty
      <input name="form_guard" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div
    class="cf-turnstile"
    data-sitekey={turnstileSiteKey}
    data-action={turnstileAction}
  ></div>

  <button
    type="submit"
    data-submit
    class="justify-self-start rounded-md bg-accent px-6 py-3 font-medium text-bg hover:opacity-90"
  >
    {labels.submitButton}
  </button>
  <p data-form-status role="status" aria-live="polite" class="text-sm"></p>
  <p class="text-sm text-muted">{labels.turnstile}</p>
</form>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  const started = Date.now();
  const elapsedField =
    document.querySelector<HTMLInputElement>('[data-elapsed]');
  const contactForm = elapsedField?.closest<HTMLFormElement>('form');
  const statusField =
    contactForm?.querySelector<HTMLElement>('[data-form-status]');
  const submitButton =
    contactForm?.querySelector<HTMLButtonElement>('[data-submit]');

  /** Turnstile tokens are single-use: a retry without a reset fails the second time. */
  function resetTurnstile() {
    const widget = (window as unknown as { turnstile?: { reset: () => void } })
      .turnstile;
    widget?.reset();
  }

  contactForm?.addEventListener('submit', async (event) => {
    if (elapsedField) elapsedField.value = String(Date.now() - started);

    // An invalid form keeps the browser's own validation UI and never reaches the network.
    if (!contactForm.checkValidity()) return;

    event.preventDefault();
    const idleLabel = submitButton?.textContent ?? '';
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = contactForm.dataset.submitting ?? idleLabel;
    }
    if (statusField) statusField.textContent = '';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        body: new FormData(contactForm),
      });
      if (response.ok) {
        // The 303 was followed, so `response.url` is the localised thanks page.
        window.location.assign(response.url);
        return;
      }
      if (statusField) {
        statusField.textContent = contactForm.dataset.errorMessage ?? '';
      }
      resetTurnstile();
    } catch {
      if (statusField) {
        statusField.textContent = contactForm.dataset.errorMessage ?? '';
      }
      resetTurnstile();
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = idleLabel;
      }
    }
  });
</script>
