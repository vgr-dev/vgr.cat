---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeSections from '../../components/HomeSections.astro';
import { locales, defaultLocale, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export const getStaticPaths = (() =>
  locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const nav = [
  { href: '#services', label: t.nav.services },
  { href: '#work', label: t.nav.work },
  { href: '#about', label: t.nav.about },
  { href: '#contact', label: t.nav.contact },
];
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <SiteHeader
    slot="header"
    lang={lang}
    brand={t.header.brand}
    nav={nav}
    menuLabel={t.header.menuLabel}
    primaryNavLabel={t.header.primaryNavLabel}
    languageNavLabel={t.header.languageNavLabel}
  />
  <HomeSections lang={lang} />
  <SiteFooter slot="footer" note={t.footer.note} />
</BaseLayout>
