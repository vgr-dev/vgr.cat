{
  "name": "vgr-cat",
  "compatibility_date": "2026-10-15",
  "main": "./src/worker/index.ts",
  "routes": [{ "pattern": "vgr.cat", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Required: not_found_handling intercepts *navigation* requests before the
    // Worker, so a browser form POST to /api/contact never reached it (405).
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Public by design. Repeated in send_email below because the binding pins the
    // same address as a hard cap while send() still requires an explicit `to`.
    "CONTACT_DESTINATION": "contact@vgr.cat",
    // Frontend hostname allowlist checked against siteverify's response. A
    // production value must never include localhost or 127.0.0.1.
    "TURNSTILE_HOSTNAMES": "vgr.cat",
  },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
  "send_email": [
    // Least privilege: even a bug cannot send the notification elsewhere.
    { "name": "NOTIFY", "destination_address": "contact@vgr.cat" },
    // Auto-reply to the visitor. Separate binding, deliberately unrestricted.
    { "name": "REPLY" },
  ],
  // A second, version-controlled layer behind the zone's "Contact Rate Limit" rule
  // (5 req / 10 s per ip.src + colo, verified live 2026-10-19). The Workers Rate Limiting API is
  // permissive and eventually consistent within a location, so this is abuse friction that is
  // reviewable in git, not a global cap. Deliberately looser than the edge rule so the two can
  // never disagree about who is abusing the endpoint.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
