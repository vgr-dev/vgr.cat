---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeSections from '../../components/HomeSections.astro';
import { locales, defaultLocale, type Locale } from '../../i18n/config';

export const getStaticPaths = (() =>
  locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Locale };
const nav = [
  { href: '#services', label: 'TODO(copy) — Services' },
  { href: '#work', label: 'TODO(copy) — Work' },
  { href: '#about', label: 'TODO(copy) — About' },
  { href: '#contact', label: 'TODO(copy) — Contact' },
];
---

<BaseLayout
  lang={lang}
  title="vgr.cat"
  description="TODO(copy) — site meta description"
>
  <SiteHeader
    slot="header"
    lang={lang}
    brand="vgr.cat"
    nav={nav}
    menuLabel="TODO(copy) — Menu"
  />
  <HomeSections />
  <SiteFooter slot="footer" note="TODO(copy) — footer note" />
</BaseLayout>
