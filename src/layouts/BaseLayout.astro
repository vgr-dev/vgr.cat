---
import '../styles/global.css';
// Resolved by Vite, so the preload carries the same hashed filename the stylesheet references.
// Only the latin subset is ever fetched for EN/CA/ES content (task 4): the other six `@font-face`
// blocks declare disjoint `unicode-range`s and cost nothing beyond a few bytes of inlined CSS.
import latinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
// Same treatment for the display face: one latin subset, preloaded because it renders the `h1`.
import displayWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import {
  defaultLocale,
  locales,
  localizedPath,
  stripLocale,
  type Locale,
} from '../i18n/config';
import { useTranslations } from '../i18n';
import { buildJsonLd } from '../lib/schema';

interface Props {
  /** Defaults to the site dictionary; per-page overrides pass their own (`thanks`, `404`). */
  title?: string;
  description?: string;
  lang?: Locale;
  /**
   * A 404 is a single prerendered file answering every path, so it has no canonical URL of
   * its own. Without this, the page advertised `https://vgr.cat/404/` as its canonical plus
   * three hreflang siblings that do not resolve (live `GET /404/` → 307, `/ca/404/` → 404).
   */
  noindex?: boolean;
  /**
   * Per-page structured data. Defaults to the home page's `Person` + `ProfessionalService` graph,
   * so a page that does not care keeps the previous behaviour and the home page keeps its nodes.
   */
  jsonLd?: Record<string, unknown>;
}

const { lang = defaultLocale, noindex = false } = Astro.props as Props;
const t = useTranslations(lang);
const {
  title = t.site.title,
  description = t.site.description,
  jsonLd: jsonLdOverride,
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 1200x630 brand card. Regeneration command is recorded in the active plan (Phase 5, Task 5.2).
const ogImageURL = new URL('/og/og-default.png', Astro.site);

const logicalPath = stripLocale(Astro.url.pathname);
const alternates = locales.map((locale) => ({
  locale,
  href: new URL(localizedPath(locale, logicalPath), Astro.site).href,
}));
const xDefaultHref = new URL(
  localizedPath(defaultLocale, logicalPath),
  Astro.site,
).href;

const ogLocale: Record<Locale, string> = {
  en: 'en_US',
  ca: 'ca_ES',
  es: 'es_ES',
};

// A detail page supplies its own graph; everything else keeps the home page's Person/Service nodes.
const jsonLd = jsonLdOverride ?? buildJsonLd({ locale: lang, t });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Progressive-enhancement marker. It runs before the body is parsed, so nothing flashes, and
      Astro hashes it for `script-src` like every other inline script it emits. `global.css` pairs
      it with the `.requires-js` / `.no-js-fallback` rules the contact form depends on.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {/*
      Resolves the theme before the first paint, so the page never flashes the other one. The
      attribute is always set: a stored choice wins, otherwise the OS preference does. Without
      scripting the attribute is absent and the stylesheet's `prefers-color-scheme` block takes
      over. Astro hashes this inline script for `script-src`, so it needs no CSP entry of its own.
    */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          // Storage can be unavailable (private mode, blocked cookies): the OS preference stands in.
        }
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex &&
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {/* Same-origin font preloads must be CORS-mode, or the browser fetches the file twice. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={latinWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={displayWoff2}
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vgr.cat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales
      .filter((locale) => locale !== lang)
      .map((locale) => (
        <meta property="og:locale:alternate" content={ogLocale[locale]} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {/*
      `JSON.stringify` does not escape `<`, so a value containing `</script>` would close this data
      block early. Escaping `<` as \u003c keeps the JSON valid (it is a legal JSON escape) and the block
      inert. CSP hashes are the second line of defence, not the first.
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />
    {/*
      Cloudflare Web Analytics is NOT emitted here. It is injected at the edge by the zone's
      Web Analytics auto-install, so it must be allowed by origin in `security.csp`
      (`static.cloudflareinsights.com` for the script, `cloudflareinsights.com` for its report).
      An explicit beacon was built first and removed deliberately: with auto-install on, shipping
      both would count every pageview twice.
    */}
  </head>
  <body>
    {/*
      Document shell only — html/head/body. Page chrome lives in `PageShell` so the skip link and the
      `main` landmark cannot be assembled twice, and so pages that intentionally have no chrome can
      supply their own `<main>`.
    */}
    <slot />
  </body>
</html>
