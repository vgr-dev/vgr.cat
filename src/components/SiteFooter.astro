---
/**
 * Footer: the end of a very long page needs a way forward, so it carries the same section links
 * the header does, plus contact and language groups (UX-016). Each group is a `<nav>` with its
 * own accessible name; the visible label is a paragraph rather than a heading so the document
 * outline stays about content.
 */
import Container from './Container.astro';
import LanguagePicker from './LanguagePicker.astro';
import { contactEmail } from '../config';
import type { Locale } from '../i18n/config';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  lang: Locale;
  tagline: string;
  builtWith: string;
  nav: NavItem[];
  sectionsLabel: string;
  contactLabel: string;
  languageLabel: string;
  bookingLabel: string;
  bookingHref: string;
  /**
   * The legal slot renders only when a policy page exists. No policy is authored yet, and a link
   * to a 404 would be worse than its absence (Q-2).
   */
  legalLabel?: string;
  legalHref?: string;
}

const {
  lang,
  tagline,
  builtWith,
  nav,
  sectionsLabel,
  contactLabel,
  languageLabel,
  bookingLabel,
  bookingHref,
  legalLabel,
  legalHref,
} = Astro.props;

// `output: 'static'` freezes the year at build time; deliberate, see plan C6.
const year = new Date().getFullYear();

const linkClass = 'inline-block py-1 hover:text-accent';
---

<footer class="border-t border-border">
  <Container class="py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <nav aria-label={sectionsLabel}>
        <p class="font-medium">{sectionsLabel}</p>
        <ul class="mt-3 grid gap-2 text-sm text-muted">
          {nav.map((item) => (
            <li>
              <a href={item.href} class={linkClass}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={contactLabel}>
        <p class="font-medium">{contactLabel}</p>
        <ul class="mt-3 grid gap-2 text-sm text-muted">
          <li>
            <a href={`mailto:${contactEmail}`} class={linkClass}>
              {contactEmail}
            </a>
          </li>
          <li>
            <a href={bookingHref} class={linkClass}>
              {bookingLabel}
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="font-medium">{languageLabel}</p>
        <div class="mt-3 text-sm text-muted">
          <LanguagePicker current={lang} label={languageLabel} />
        </div>
        {legalHref && legalLabel && (
          <nav aria-label={legalLabel} class="mt-4">
            <a href={legalHref} class:list={[linkClass, 'text-sm text-muted']}>
              {legalLabel}
            </a>
          </nav>
        )}
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>{tagline}</p>
      <p>
        © {year} VGR. {builtWith}
      </p>
    </div>
  </Container>
</footer>
