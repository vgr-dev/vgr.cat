---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import Container from '../../components/Container.astro';
import { defaultLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t.thanks.title}
  description={t.thanks.body}
  noindex
>
  <PageShell lang={lang}>
    <Container class="py-24">
      <h1 class="text-3xl font-semibold tracking-tight">{t.thanks.heading}</h1>
      <p class="mt-4 max-w-2xl text-muted">{t.thanks.body}</p>
      <p class="mt-8">
        <a href="/" class="text-accent hover:underline">
          {t.thanks.back}
        </a>
      </p>
    </Container>
  </PageShell>
</BaseLayout>
